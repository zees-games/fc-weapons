# Godot 4
.godot/
.import/
/android/

# The gs-* addons are separate repositories and are linked in, never committed.
# For local development, symlink them from a sibling checkout:
#   ln -s ../../gs-core/addons/gs_core addons/gs_core
# bootstrap.sh derives this project's dependencies from the lines below, so a
# dependency added here is a dependency it links on the next run.
/addons/gs_core
/addons/gs_profile
/addons/gs_combat
/addons/gs_weapon
/addons/gs_net
/addons/gs_physics
/addons/gs_fx
/addons/gs_audio
/addons/gs_player
/addons/gs_player_controller
/addons/gs_player_char

# Exports
build/
export.cfg
export_presets.cfg
*.translation

# Screenshots are evidence for a review, not assets.
/screenshots/

# OS
.DS_Store
Thumbs.db

# Editors
.vscode/

# Blender runs the art-src scripts and leaves bytecode beside them.
__pycache__/
art-src/reference/


# Opt-in 2K Poly Haven weapon glbs (tools/bake_polyhaven.py output) and the textures Godot extracts from them.
/addons/fc_weapons/assets/models/*_2k.glb*
/addons/fc_weapons/assets/models/*_2k.jpg*
# stick_grenade.glb is the 1K bake but its images keep Poly Haven's _2k names; its textures ship.
!/addons/fc_weapons/assets/models/stick_grenade_stick_grenade_*_2k.jpg*

# make_fire_sounds.py downloads its CC0 rocket recordings here; the generated layers are what ship.
/tools/sound_sources/

# Sibling addons linked for local suites (absolute links must never be tracked; CI resolves them from addons.lock):
/addons/godot-sqlite
/addons/gs_bot
/addons/gs_bot_record
/addons/gs_sim
/addons/gs_sql
